PORT=3000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:3001
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=replace-with-local-password
DB_DATABASE=simple_banking_app_final
DB_SYNCHRONIZE=false
DB_LOGGING=false
JWT_SECRET=replace-with-random-64-character-secret
BANKFLOW_QUEUE_ENABLED=false
BANKFLOW_BATCH_QUEUE_ENABLED=false
BANKFLOW_BATCH_WORKER_CONCURRENCY=1
BANKFLOW_WORKER_CONCURRENCY=1
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Optional security integration (enable only AFTER applying migrations/20261027_transaction_crypto.sql)
# When enabled, transaction descriptions are stored as AES-256-GCM ciphertext, and completed transfers get Ed25519 receipts.
# Generate your local values: npm run crypto:keygen
BANKFLOW_CRYPTO_ENABLED=false
TRANSACTION_ENCRYPTION_KEY=
TRANSACTION_SIGN_PRIVATE_KEY_B64=
TRANSACTION_SIGN_PUBLIC_KEY_B64=

# AI demo chạy cục bộ trên máy, chỉ phục vụ phân tích sau giao dịch
AI_SERVICE_URL=http://127.0.0.1:8008
